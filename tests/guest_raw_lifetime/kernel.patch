diff --git a/fs/proc/cplife.c b/fs/proc/cplife.c
new file mode 100644
index 0000000..3729e81
--- /dev/null
+++ b/fs/proc/cplife.c
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Fixed, unqualified, guest-only raw source experiment. No target references held.
+ * Buffer ordinal is emission order, NOT kernel-effect linearization order.
+ */
+#include <linux/atomic.h>
+#include <linux/cplife.h>
+#include <linux/fdtable.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/ktime.h>
+#include <linux/nmi.h>
+#include <linux/proc_fs.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <generated/utsrelease.h>
+
+struct cpl_record {
+  u64 seq, table, ofd, old, mono;
+  const char *kind;
+  int fd;
+  unsigned int flags;
+  bool valid;
+};
+static struct cpl_record records[128];
+static atomic64_t attempted = ATOMIC64_INIT(0);
+static atomic64_t reserved = ATOMIC64_INIT(0);
+static atomic64_t committed = ATOMIC64_INIT(0);
+static atomic64_t failed = ATOMIC64_INIT(0);
+static atomic64_t cookies = ATOMIC64_INIT(0);
+static struct files_struct *root_files;
+static unsigned int capacity = 128;
+static const char *case_name;
+static bool active, ever_armed, stopped, force_loss;
+
+static bool cpl_current_scope(void)
+{
+  struct files_struct *files;
+  if (!smp_load_acquire(&active))
+    return false;
+  files = current->files;
+  return files && (files == READ_ONCE(root_files) || READ_ONCE(files->cpl_cookie));
+}
+
+static void cpl_emit(const char *kind, u64 table, u64 ofd, u64 old,
+                     int fd, unsigned int flags)
+{
+  struct cpl_record *r;
+  u64 seq;
+  /* Admitted hooks for this fixed workload are process/task-work context only.
+   * An NMI invocation is outside this diagnostic profile, not zero global loss.
+   */
+  if (in_nmi())
+    return;
+  rcu_read_lock();
+  if (!smp_load_acquire(&active))
+    goto out;
+  seq = atomic64_inc_return(&attempted);
+  if (!seq || seq > capacity || (force_loss && seq == 2)) {
+    atomic64_inc(&failed);
+    goto out;
+  }
+  atomic64_inc(&reserved);
+  r = &records[seq - 1];
+  r->seq = seq; r->kind = kind; r->table = table;
+  r->ofd = ofd; r->old = old; r->fd = fd; r->flags = flags;
+  r->mono = ktime_get_mono_fast_ns();
+  smp_store_release(&r->valid, true);
+  atomic64_inc(&committed);
+out:
+  rcu_read_unlock();
+}
+
+void cpl_file_birth(struct file *file)
+{
+  if (!cpl_current_scope())
+    return;
+  file->cpl_cookie = atomic64_inc_return(&cookies);
+  cpl_emit("FILE_NEW", 0, file->cpl_cookie, 0, -1, 0);
+}
+
+void cpl_file_free(u64 cookie)
+{
+  if (cookie)
+    cpl_emit("FILE_FREE", 0, cookie, 0, -1, 0);
+}
+
+void cpl_table_birth(struct files_struct *files, struct files_struct *old)
+{
+  if (!cpl_current_scope())
+    return;
+  files->cpl_cookie = atomic64_inc_return(&cookies);
+  cpl_emit("TABLE_NEW", files->cpl_cookie, 0, old->cpl_cookie, -1, 0);
+}
+
+void cpl_table_free(u64 cookie)
+{
+  if (cookie)
+    cpl_emit("TABLE_FREE", cookie, 0, 0, -1, 0);
+}
+
+void cpl_binding(const char *kind, struct files_struct *files, struct file *file,
+                 struct file *old, int fd, unsigned int flags)
+{
+  if (files != READ_ONCE(root_files) && !files->cpl_cookie)
+    return;
+  cpl_emit(kind, files->cpl_cookie, file ? file->cpl_cookie : 0,
+           old ? old->cpl_cookie : 0, fd, flags);
+}
+
+static ssize_t cpl_write(struct file *file, const char __user *buffer,
+                          size_t count, loff_t *pos)
+{
+  char command[32];
+  if (task_pid_nr(current) != 1 || count >= sizeof(command))
+    return -EINVAL;
+  if (copy_from_user(command, buffer, count))
+    return -EFAULT;
+  command[count] = 0;
+  if (!strcmp(command, "stop\n")) {
+    if (!active)
+      return -EINVAL;
+    smp_store_release(&active, false);
+    synchronize_rcu();
+    stopped = true;
+    return count;
+  }
+  if (ever_armed)
+    return -EBUSY;
+  if (!strcmp(command, "arm normal\n"))
+    case_name = "NORMAL";
+  else if (!strcmp(command, "arm fail\n")) {
+    case_name = "FORCED_LOSS";
+    force_loss = true;
+  } else if (!strcmp(command, "arm small\n")) {
+    case_name = "SMALL_BUFFER";
+    capacity = 2;
+  } else
+    return -EINVAL;
+  /* Borrowed pointer solely to the fixed living PID1's unchanged namespace;
+   * this is scope context, never an allocation cookie or a retained reference.
+   */
+  root_files = current->files;
+  ever_armed = true;
+  smp_store_release(&active, true);
+  return count;
+}
+
+static int cpl_show(struct seq_file *m, void *v)
+{
+  unsigned int i;
+  u64 n, a, r, c, f;
+  if (!ever_armed || active || !stopped)
+    return -EAGAIN;
+  a = atomic64_read(&attempted); r = atomic64_read(&reserved);
+  c = atomic64_read(&committed); f = atomic64_read(&failed);
+  seq_printf(m, "CPL_META version=1 case=%s release=%s cpus=1 capacity=%u\n",
+             case_name, UTS_RELEASE, capacity);
+  seq_printf(m, "CPL_COUNT attempted=%llu reserved=%llu committed=%llu failed=%llu discarded=0 pending=%llu\n",
+             a, r, c, f, r - c);
+  n = min_t(u64, a, capacity);
+  for (i = 0; i < n; i++) {
+    struct cpl_record *e = &records[i];
+    if (!smp_load_acquire(&e->valid))
+      continue;
+    seq_printf(m, "CPL_EVENT seq=%llu kind=%s table=%llu ofd=%llu old=%llu fd=%d flags=%u mono=%llu\n",
+               e->seq, e->kind, e->table, e->ofd, e->old, e->fd, e->flags, e->mono);
+  }
+  seq_puts(m, "CPL_END\n");
+  return 0;
+}
+
+static int cpl_open(struct inode *inode, struct file *file)
+{
+  return single_open(file, cpl_show, NULL);
+}
+
+static const struct proc_ops cpl_ops = {
+  .proc_open = cpl_open, .proc_read = seq_read, .proc_write = cpl_write,
+  .proc_lseek = seq_lseek, .proc_release = single_release,
+};
+
+static int __init cpl_init(void)
+{
+  if (num_possible_cpus() != 1)
+    return -EINVAL;
+  return proc_create("cplife", 0600, NULL, &cpl_ops) ? 0 : -ENOMEM;
+}
+fs_initcall(cpl_init);
