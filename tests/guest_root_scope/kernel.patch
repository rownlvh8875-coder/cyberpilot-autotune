diff --git a/fs/proc/cplife.c b/fs/proc/cplife.c
new file mode 100644
index 0000000..50fef52
--- /dev/null
+++ b/fs/proc/cplife.c
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Disposable fixed guest only. No target references or pointer scope registry.
+ * Emission ordinal is NOT target-effect linearization order.
+ */
+#include <linux/atomic.h>
+#include <linux/cplife.h>
+#include <linux/fdtable.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/ktime.h>
+#include <linux/nmi.h>
+#include <linux/proc_fs.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <generated/utsrelease.h>
+
+struct cpl_record {
+  u64 seq, scope, actor, task, table, ofd, old, mono;
+  const char *kind;
+  int fd, flags;
+  bool valid;
+};
+static struct cpl_record records[128];
+static atomic64_t attempted = ATOMIC64_INIT(0);
+static atomic64_t reserved = ATOMIC64_INIT(0);
+static atomic64_t committed = ATOMIC64_INIT(0);
+static atomic64_t failed = ATOMIC64_INIT(0);
+static atomic64_t cookies = ATOMIC64_INIT(0);
+static u64 root_cookie;
+static unsigned int capacity = 128;
+static const char *case_name;
+static bool active, ever_armed, stopped, force_loss;
+
+static void cpl_emit(const char *kind, u64 scope, u64 task, u64 table,
+                     u64 ofd, u64 old, int fd, int flags)
+{
+  struct cpl_record *r;
+  u64 seq;
+  /* Only process/task-work context is in profile. NMI is unknown, not zero. */
+  if (in_nmi())
+    return;
+  rcu_read_lock();
+  if (!scope || !smp_load_acquire(&active))
+    goto out;
+  seq = atomic64_inc_return(&attempted);
+  if (!seq || seq > capacity || (force_loss && seq == 1)) {
+    atomic64_inc(&failed);
+    goto out;
+  }
+  atomic64_inc(&reserved);
+  r = &records[seq - 1];
+  r->seq = seq; r->kind = kind; r->scope = scope;
+  r->actor = current->cpl_task_cookie; r->task = task;
+  r->table = table; r->ofd = ofd; r->old = old;
+  r->fd = fd; r->flags = flags; r->mono = ktime_get_mono_fast_ns();
+  smp_store_release(&r->valid, true);
+  atomic64_inc(&committed);
+out:
+  rcu_read_unlock();
+}
+
+void cpl_task_alloc(struct task_struct *task, unsigned long flags)
+{
+  /* dup_task_struct copied its parent: NEVER inherit the parent's task identity. */
+  task->cpl_task_cookie = 0;
+  task->cpl_scope_cookie = 0;
+  if (!smp_load_acquire(&active) ||
+      (flags & (CLONE_FILES | CLONE_THREAD | CLONE_VM | CLONE_VFORK | CLONE_PARENT)))
+    return;
+  if (current->cpl_scope_cookie) {
+    task->cpl_scope_cookie = current->cpl_scope_cookie;
+  } else if (task_pid_nr(current) != 1 || root_cookie) {
+    return;
+  }
+  task->cpl_task_cookie = atomic64_inc_return(&cookies);
+  if (!task->cpl_scope_cookie) {
+    root_cookie = task->cpl_task_cookie;
+    task->cpl_scope_cookie = root_cookie;
+  }
+  cpl_emit("TASK_ALLOC", task->cpl_scope_cookie, task->cpl_task_cookie,
+           0, 0, 0, -1, -1);
+}
+
+void cpl_task_files(struct task_struct *task, struct files_struct *old)
+{
+  struct files_struct *files = task->files;
+  if (!task->cpl_scope_cookie)
+    return;
+  files->cpl_cookie = atomic64_inc_return(&cookies);
+  files->cpl_scope = task->cpl_scope_cookie;
+  cpl_emit("TABLE_NEW", files->cpl_scope, task->cpl_task_cookie,
+           files->cpl_cookie, 0, old->cpl_cookie, -1, -1);
+}
+
+void cpl_task_commit(struct task_struct *task)
+{
+  if (task->cpl_scope_cookie)
+    cpl_emit("TASK_COMMIT", task->cpl_scope_cookie, task->cpl_task_cookie,
+             task->files ? task->files->cpl_cookie : 0, 0, 0, -1, -1);
+}
+
+void cpl_file_birth(struct file *file)
+{
+  u64 scope = current->cpl_scope_cookie;
+  if (!scope || !smp_load_acquire(&active))
+    return;
+  file->cpl_cookie = atomic64_inc_return(&cookies);
+  file->cpl_scope = scope;
+  cpl_emit("FILE_NEW", scope, 0, 0, file->cpl_cookie, 0, -1, -1);
+}
+
+void cpl_file_free(u64 cookie, u64 scope)
+{
+  if (cookie)
+    cpl_emit("FILE_FREE", scope, 0, 0, cookie, 0, -1, -1);
+}
+
+void cpl_table_free(u64 cookie, u64 scope)
+{
+  if (cookie)
+    cpl_emit("TABLE_FREE", scope, 0, cookie, 0, 0, -1, -1);
+}
+
+void cpl_binding(const char *kind, struct files_struct *files, struct file *file,
+                 struct file *old, int fd, int flags)
+{
+  if (!files->cpl_scope)
+    return;
+  cpl_emit(kind, files->cpl_scope, 0, files->cpl_cookie,
+           file ? file->cpl_cookie : 0, old ? old->cpl_cookie : 0, fd, flags);
+}
+
+static ssize_t cpl_write(struct file *file, const char __user *buffer,
+                          size_t count, loff_t *pos)
+{
+  char command[32];
+  if (task_pid_nr(current) != 1 || count >= sizeof(command))
+    return -EINVAL;
+  if (copy_from_user(command, buffer, count))
+    return -EFAULT;
+  command[count] = 0;
+  if (!strcmp(command, "stop\n")) {
+    if (!active)
+      return -EINVAL;
+    smp_store_release(&active, false);
+    synchronize_rcu();
+    stopped = true;
+    return count;
+  }
+  if (ever_armed)
+    return -EBUSY;
+  if (!strcmp(command, "arm normal\n"))
+    case_name = "NORMAL";
+  else if (!strcmp(command, "arm fail\n")) {
+    case_name = "ROOT_BIRTH_LOSS";
+    force_loss = true;
+  } else if (!strcmp(command, "arm small\n")) {
+    case_name = "SMALL_BUFFER";
+    capacity = 2;
+  } else
+    return -EINVAL;
+  ever_armed = true;
+  smp_store_release(&active, true);
+  return count;
+}
+
+static int cpl_show(struct seq_file *m, void *v)
+{
+  unsigned int i;
+  u64 n, a, r, c, f;
+  if (!ever_armed || active || !stopped)
+    return -EAGAIN;
+  a = atomic64_read(&attempted); r = atomic64_read(&reserved);
+  c = atomic64_read(&committed); f = atomic64_read(&failed);
+  seq_printf(m, "CPS_META version=1 case=%s release=%s cpus=1 capacity=%u root=%llu\n",
+             case_name, UTS_RELEASE, capacity, root_cookie);
+  seq_printf(m, "CPS_COUNT attempted=%llu reserved=%llu committed=%llu failed=%llu discarded=0 pending=%llu\n",
+             a, r, c, f, r - c);
+  n = min_t(u64, a, capacity);
+  for (i = 0; i < n; i++) {
+    struct cpl_record *e = &records[i];
+    if (!smp_load_acquire(&e->valid))
+      continue;
+    seq_printf(m, "CPS_EVENT seq=%llu kind=%s scope=%llu actor=%llu task=%llu table=%llu ofd=%llu old=%llu fd=%d flags=%d mono=%llu\n",
+               e->seq, e->kind, e->scope, e->actor, e->task, e->table,
+               e->ofd, e->old, e->fd, e->flags, e->mono);
+  }
+  seq_puts(m, "CPS_END\n");
+  return 0;
+}
+
+static int cpl_open(struct inode *inode, struct file *file)
+{
+  return single_open(file, cpl_show, NULL);
+}
+
+static const struct proc_ops cpl_ops = {
+  .proc_open = cpl_open, .proc_read = seq_read, .proc_write = cpl_write,
+  .proc_lseek = seq_lseek, .proc_release = single_release,
+};
+
+static int __init cpl_init(void)
+{
+  if (num_possible_cpus() != 1)
+    return -EINVAL;
+  return proc_create("cpscope", 0600, NULL, &cpl_ops) ? 0 : -ENOMEM;
+}
+fs_initcall(cpl_init);
