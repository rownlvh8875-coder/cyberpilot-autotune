+/* Disposable diagnostic experiment only; requires CONFIG_PROC_FS=y. */
+#ifndef _LINUX_CPLIFE_H
+#define _LINUX_CPLIFE_H
+#include <linux/types.h>
+struct file;
+struct files_struct;
+struct task_struct;
+struct seq_file;
+u64 cpl_issue_cookie(void);
+bool cpl_is_active(void);
+void cpc_reset_task(struct task_struct *task);
+void cpc_attempt(struct task_struct *task, struct files_struct *old);
+bool cpc_fault(struct task_struct *task, int point);
+void cpc_allocated(struct task_struct *task, struct files_struct *files);
+void cpc_begin(struct task_struct *task, unsigned int bound, unsigned int capacity);
+void cpc_bitmaps(struct task_struct *task, unsigned long opened, unsigned long cloexec);
+u64 cpc_read(struct task_struct *task, unsigned int fd, struct file *file);
+void cpc_step(struct task_struct *task, const char *kind, unsigned int fd,
+              u64 read, struct file *file);
+void cpc_return(struct task_struct *task, bool success, const char *reason);
+void cpc_alloc_free(struct task_struct *task, const char *reason);
+void cpc_finalize(struct task_struct *task, bool committed);
+const char *cpc_arm(const char *command);
+int cpb_seed(const char *command);
+bool cpb_seed_attempted(void);
+void cpb_armed(void);
+void cpb_stop(void);
+void cpb_show(struct seq_file *m, u64 root);
+void cpb_node(const char *role, u64 cookie, unsigned int origin);
+struct files_struct *dup_fd_for_task(struct files_struct *old, struct task_struct *task);
+void cpl_task_alloc(struct task_struct *task, unsigned long clone_flags);
+void cpl_task_files(struct task_struct *task, struct files_struct *old);
+void cpl_task_commit(struct task_struct *task);
+void cpl_file_birth(struct file *file);
+void cpl_file_free(u64 cookie, u64 scope);
+void cpl_table_free(u64 cookie, u64 scope);
+void cpl_binding(const char *kind, struct files_struct *files, struct file *file,
+                 struct file *old, int fd, int flags);
+#endif
