diff --git a/include/linux/cptagread.h b/include/linux/cptagread.h
--- /dev/null
+++ b/include/linux/cptagread.h
@@ -0,0 +1,20 @@
+/* Diagnostic scalar copy only. No lifetime/publication proof or extra pin. */
+#ifndef _LINUX_CPTAGREAD_H
+#define _LINUX_CPTAGREAD_H
+struct cpt_snapshot {
+  u64 cookie, scope;
+  unsigned int epoch, origin;
+  bool captured;
+};
+
+static inline struct cpt_snapshot cpt_take(struct file *file)
+{
+  return (struct cpt_snapshot){
+    .cookie = READ_ONCE(file->cpl_cookie),
+    .scope = READ_ONCE(file->cpl_scope),
+    .epoch = READ_ONCE(file->cpb_epoch),
+    .origin = READ_ONCE(file->cpb_origin),
+    .captured = true,
+  };
+}
+#endif
